{
  "name": "Path to Presidency",
  "short_name": "Path to Presidency",
  "description": "The free scoring app for the Path to Presidency board game.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1d3557",
